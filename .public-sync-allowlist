# ==============================================================================
# Public Sync Allowlist for imgtxd-studio
# Only paths explicitly matching '+' patterns below will be synced to public repo.
# Everything else is strictly excluded by default ('- *').
# ==============================================================================

# App source and build configuration
+ /app/
+ /app/src/***
+ /app/build.gradle.kts
+ /app/proguard-rules.pro

# Gradle wrapper and build configuration
+ /gradle/***
+ /build.gradle.kts
+ /settings.gradle.kts
+ /gradle.properties
+ /gradlew
+ /gradlew.bat

# Public GitHub Actions workflows
+ /.github/
+ /.github/workflows/
+ /.github/workflows/build.yml

# Project documentation & meta
+ /.gitignore
+ /README.md
+ /LICENSE
+ /.public-sync-allowlist

# Block everything else (keystores, local properties, tokens, private workflows)
- *
