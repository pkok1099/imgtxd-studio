<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- WRITE_EXTERNAL_STORAGE dihapus: maxSdkVersion=29 di bawah minSdk=31,
         permission ini sudah mati sejak minSdk dinaikkan ke Android 12. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".ImgTxdStudioApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.ImgTxdStudio">

        <!-- IMG Archive Editor Activity -->
        <activity
            android:name="com.onlasdan.studio.ui.MainActivity"
            android:exported="true"
            android:taskAffinity="${applicationId}.img"
            android:launchMode="singleTask"
            android:documentLaunchMode="intoExisting"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/app_name">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Intent filter for opening .img files from file managers -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.img" />
                <data android:pathPattern=".*\\.IMG" />
            </intent-filter>

        </activity>

        <!-- Texdb Cache Browser (Fase 2, read-only) -->
        <activity
            android:name="com.onlasdan.studio.ui.TexdbBrowserActivity"
            android:exported="false"
            android:taskAffinity="${applicationId}.texdb"
            android:launchMode="singleTask"
            android:documentLaunchMode="intoExisting"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:label="Cache Texdb - ImgTxd Studio" />

        <!-- Data Lines Helper (tempel baris handling/ide/carcols) -->
        <activity
            android:name="com.onlasdan.studio.ui.DataLinesActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:label="Tempel Baris Data - ImgTxd Studio" />

        <!-- DFF Inspector (report + rename texture di dalam DFF) -->
        <activity
            android:name="com.onlasdan.studio.ui.DffInspectorActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:label="Inspeksi DFF - ImgTxd Studio" />

        <!-- TXD Texture Editor Activity -->
        <activity
            android:name="com.onlasdan.studio.ui.TxdEditorActivity"
            android:exported="true"
            android:taskAffinity="${applicationId}.txd"
            android:launchMode="singleTask"
            android:documentLaunchMode="intoExisting"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:label="Txd Editor - ImgTxd Studio">

            <!-- Intent filter for opening .txd files directly from file managers -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.txd" />
                <data android:pathPattern=".*\\.TXD" />
            </intent-filter>

        </activity>

        <!-- Worker Service for Background Operations -->
        <service
            android:name="com.onlasdan.studio.worker.WorkerService"
            android:process=":worker"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Long-running local file processing (archive rebuild, texture conversion) that the user starts explicitly and monitors in-app; not covered by any other FGS type." />
        </service>

        <!-- Watchdog Guardian Receiver for Resilience & Auto-Resume.
             Hanya broadcast protected sistem yang di-declare di sini
             (RESUME_INTERRUPTED_JOBS / WATCHDOG_PING dikirim eksplisit oleh
             aplikasi sendiri dan di-guard package pengirim di onReceive;
             receiver tetap exported agar BOOT_COMPLETED selalu terkirim). -->
        <receiver
            android:name="com.onlasdan.studio.worker.JobGuardianReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Official Shizuku Provider for Binder Token Handshake -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>
